# PostgreSQL superuser password, used by the indexer and when the database is initialised
DMD_DB_POSTGRES_PASS=change-me-to-a-strong-password

# Password of the diamond_api role that is created when the database is initialised
DMD_DB_API_PASS=change-me-to-a-strong-password

# Host port the database is published on (bound to 127.0.0.1)
DMD_DB_POSTGRES_PORT=5433

# Database address used when running the indexer from source (compose.yaml sets db:5432)
POSTGRES_INSTANCE=127.0.0.1:5433

# JSON-RPC endpoint of the DMD Diamond network
RPC_URL=https://rpc.bit.diamonds

# Optional block range. DB_FILL_START_BLOCK bootstraps the chain state at that block
# when the database does not reach it yet; DB_FILL_STOP_BLOCK stops after that block.
# With both empty the indexer continues from the last processed block (block 0 on an
# empty database) and keeps following the chain head.
DB_FILL_START_BLOCK=
DB_FILL_STOP_BLOCK=

# Log every processing step
DEV_TOOLS_LOG_DEBUG=false

# Naming system contracts; the mainnet addresses are used when empty
DMD_REGISTRAR_CONTROLLER_ADDRESS=
DMD_NAMES_ADDRESS=
